# Copy this file to .env and fill in your own values. Never commit .env.

APP_NAME=Smart Plant Monitor
ENVIRONMENT=development

# Database
# On your own computer a SQLite file is the simplest:
DATABASE_URL=sqlite:///./plant.db
# For MySQL (used on the server), URL-encode any special characters in the password:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/plantmonitor

# Application security
# Use at least 32 random characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# false for local HTTP; set true when serving behind HTTPS.
SESSION_HTTPS_ONLY=false
